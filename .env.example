# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# Connection string for your PostgreSQL database.
# Works with: Neon, Vercel Postgres, Supabase, local PostgreSQL, any PostgreSQL
#
POSTGRES_URL="postgres://user:password@host:port/database?sslmode=require"

# Optional: For Vercel Postgres, this is set automatically
POSTGRES_URL_NON_POOLING="postgres://user:password@host:port/database?sslmode=require"

# =============================================================================
# Database Provider (Optional - auto-detected if not set)
# =============================================================================
# Override automatic provider detection. Options:
#   - "neon"     : Neon serverless (auto-detected from *.neon.tech URLs)
#   - "vercel"   : Vercel Postgres (auto-detected when VERCEL=1)
#   - "postgres" : Standard postgres.js client (default for local dev)
#
# Auto-detection priority:
#   1. DB_PROVIDER env var (this setting)
#   2. Connection string contains ".neon.tech" → neon
#   3. VERCEL=1 environment variable → vercel
#   4. Default → postgres
#
# DB_PROVIDER="neon"

# =============================================================================
# App URL (for building receipt URLs)
# =============================================================================
NEXT_PUBLIC_APP_URL="https://utmessa.peritus.is"

# =============================================================================
# Email Notifications (Resend)
# =============================================================================
# Get your API key from https://resend.com/api-keys
# Emails are sent on status changes: running, waiting, deployed, failed
#
RESEND_API_KEY="re_xxxxxxxxxx"

# From address for emails (must be verified domain in Resend)
# Format: "Name <email@domain.com>"
EMAIL_FROM="POC Smiður <noreply@utmessa.peritus.is>"

# =============================================================================
# Orchestrator Authentication
# =============================================================================
# Shared secret key for authenticating requests from the Orchestrator service.
# Used to verify X-ORCH-KEY header in protected API endpoints.
#
# SECURITY REQUIREMENTS:
# - Generate a cryptographically secure random string (minimum 32 characters)
# - Use the same value in both Intake and Orchestrator services
# - Never commit the actual value to version control
# - Mark as "Sensitive" in Vercel dashboard to hide from logs
#
# To generate a secure key:
#   openssl rand -base64 32
#   # or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
ORCH_KEY="your-secure-shared-secret-here"
